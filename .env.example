# Neon에서 복사한 "pooled connection" 문자열
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# openssl rand -base64 32 (또는 임의의 32자 이상 랜덤 문자열) — 세션 쿠키 서명용
SESSION_SECRET="change-this-to-a-random-32-character-or-longer-string"

# 로그인 계정 목록 (JSON 배열, 한 줄로). 아이디+비밀번호 입력창이 아니라
# "어떤 비밀번호를 입력했는지"로 계정을 구분한다 — 비밀번호마다 역할이 다르다.
# role은 "admin" 또는 "worker" (지금은 기능 차이는 없고 기록용).
ACCOUNTS_JSON=[{"id":"master","password":"change-this-master-password","displayName":"마스터","role":"admin"},{"id":"worker1","password":"change-this-worker-password","displayName":"작업자1","role":"worker"}]
