datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model OrderLine {
  id String @id @default(cuid())

  orderNo     String // 오더번호
  productCode String // 상품코드
  colorCode   String // 컬러코드 (컬러별 SKU)
  productName String // 상품명
  colorName   String // 컬러

  requestedQty Int? // 출고요청수량
  shipDate     DateTime? // 이동일자 (주희물류→제이에스)
  shippedQty   Int? // 이동수량

  inspectedQty Int? // 제품검수수량 — 관리자가 직접 세어서 입력하는 수치(양품수량 계산 기준)
  scannedQty   Int? // 바코드검수수량 — 바코드 스캔 1건(일치+불일치 전체)마다 자동 집계, 수동 입력 불가.
  // 둘 다 "검수수량"이지만 서로 다른 방식으로 센 숫자라 한 칸에 합치면 어긋난다 —
  // 바코드검수수량은 스캔 건수, 제품검수수량은 관리자가 현물/엑셀 기준으로 세는 숫자.
  // 서로 대조해서 확인하라고 별도 칸으로 둔다.
  defectQty    Int? // 불량수량 — 바코드 불일치 스캔 또는 관리자 직접 입력
  // 양품수량 = 제품검수수량 - 불량수량 은 저장하지 않고 항상 계산한다 (src/lib/compute.ts)

  returnDate DateTime? // 복귀일자 (제이에스→주희물류)
  returnQty  Int? // 복귀수량
  // 차이 = 이동수량 - 복귀수량 은 저장하지 않고 항상 계산한다

  notes String? // 비고

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String? // 마지막으로 이 행을 바꾼 계정 id (로그인 계정의 accountId, 예: "jsc")

  @@unique([orderNo, productCode, colorCode], name: "orderLineKey")
  @@index([orderNo])
}

model Import {
  id            String   @id @default(cuid())
  filename      String
  type          String // SHIPMENT | INSPECTION | MIXED
  uploadedAt    DateTime @default(now())
  uploadedBy    String? // 업로드한 계정 id
  insertedCount Int
  updatedCount  Int
  skippedCount  Int
  errorCount    Int
}

// 품번/컬러/사이즈별 바코드 레지스트리 — 바코드 검수 화면에서 스캔값과 대조하는 기준표
model BarcodeProduct {
  id          String   @id @default(cuid())
  productCode String // 상품코드
  productName String // 상품명
  colorName   String // 컬러
  sizeName    String // 사이즈
  barcode1    String // 기본 바코드
  barcode2    String? // 보조 바코드 (있는 경우)
  imageUrl    String? // 상품 이미지 URL (외부 호스팅 — 파일을 이 앱에 저장하지 않음)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productCode, colorName, sizeName], name: "barcodeProductKey")
  @@index([barcode1])
}

// 바코드 스캔 1건 = 1행. 오더번호는 자유 입력(해당 오더 작업임을 표시)이며 OrderLine과 강제 연결하지 않는다.
model ScanLog {
  id              String   @id @default(cuid())
  scannedAt       DateTime @default(now())
  orderNo         String
  productCode     String
  productName     String
  colorName       String
  sizeName        String
  scannedBarcode  String
  expectedBarcode String?
  result          String // MATCH | MISMATCH
  scannedBy       String? // 스캔한 계정 id

  @@index([orderNo])
  @@index([scannedAt])
}
